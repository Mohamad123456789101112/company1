# ════════════════════════════════════════════════════════════════
# 🔐 ملف الإعدادات الحساس (Secure Config)
# هذا الملف محمي وغير مرفوع على Git أبدًا (.gitignore).
# كل القيم هنا تُقرأ من السيرفر فقط عبر src/lib/secure-config.ts
# وممنوع تمامًا ظهورها أو فتحها داخل لوحة تحكم الأدمن.
# في الإنتاج: Vercel → Settings → Environment Variables
# ════════════════════════════════════════════════════════════════

# ───────────── قاعدة البيانات (Supabase) ─────────────
# Supabase → Project Settings → Database → Connection string (URI) – Session pooler (port 5432)
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# اختياري: اجبار/تعطيل SSL (يُفعّل تلقائيًا لأي اتصال غير محلي)
# DATABASE_SSL=true
# DATABASE_POOL_MAX=5

# ───────────── رابط الموقع (مهم لـ Google OAuth والكوكيز الآمنة) ─────────────
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# ───────────── حسابات المدير ─────────────
# أي بريد هنا يُرقّى تلقائيًا إلى مدير عند التسجيل أو الدخول (مفصولة بفاصلة)
ADMIN_EMAILS=you@gmail.com

# ───────────── تسجيل الدخول عبر Google ─────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URI:  https://your-domain.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# ───────────── تأمين المحتوى ─────────────
# سر توقيع روابط الفيديو/PDF المؤقتة (أي نص عشوائي طويل 32+ حرف) – إلزامي في الإنتاج
MEDIA_SIGNING_SECRET=change-me-to-a-long-random-string
# اختياري: مفتاح Token Authentication من Bunny Stream لتوقيع روابط الفيديو وانتهائها تلقائيًا
# BUNNY_TOKEN_AUTH_KEY=

# ───────────── ملف أكواد الـ SQL (Supabase SQL Editor) ─────────────
# مسار ملف الـ SQL الذي تنشئ منه القاعدة – يُقرأ من السيرفر فقط
# ويُمنع عرضه أو فتحه داخل لوحة التحكم (حماية للمنصة).
# SUPABASE_SQL_FILE=supabase/schema.sql
