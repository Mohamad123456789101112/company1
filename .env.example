# ═════════════════════════════════════════════════════════════════
#  🔒 ملف الإعدادات المحمي — انسخه إلى .env.local ولا تضعه في Git أبدًا
#     cp .env.example .env.local
#  القيم الحقيقية تعيش هنا فقط أو في Vercel → Environment Variables.
#  لا يوجد أي مكان في لوحة تحكم الأدمن يعرض هذه القيم.
# ═════════════════════════════════════════════════════════════════

# ───────────── قاعدة البيانات (Supabase) ─────────────
# Supabase → Project Settings → Database → Connection string (URI)
# استخدم Session pooler (port 5432) للتوافق مع Vercel
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# اختياري: إجبار/تعطيل SSL (يُفعّل تلقائيًا لأي اتصال غير محلي)
# DATABASE_SSL=true
# DATABASE_POOL_MAX=5

# ───────────── رابط الموقع (مهم لـ Google OAuth والكوكيز الآمنة) ─────────────
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# ───────────── حسابات المدير ─────────────
# أي بريد هنا يُرقّى تلقائيًا إلى مدير عند التسجيل أو الدخول (مفصولة بفاصلة)
ADMIN_EMAILS=you@gmail.com

# ───────────── تسجيل الدخول عبر Google (Google Auth) ─────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URI:
#   https://your-domain.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# ───────────── تأمين المحتوى ─────────────
# سر توقيع روابط الفيديو/PDF المؤقتة (نص عشوائي طويل 32+ حرف) – إلزامي في الإنتاج
# لتوليد واحد: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
MEDIA_SIGNING_SECRET=change-me-to-a-long-random-string
# اختياري: مفتاح Token Authentication من Bunny Stream
# BUNNY_TOKEN_AUTH_KEY=
